---
interface Props {
  heading: string;
  body: string;
  action?: string;
  mediaSide?: 'left' | 'right';
  note?: string;
}

const { heading, body, action, mediaSide = 'right', note } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section
  data-component="content-section"
  data-note={note}
  class:list={[{ 'with-media': hasMedia }, mediaSide]}
>
  {
    hasMedia && (
      <div class="media">
        <slot name="media" />
      </div>
    )
  }
  <div class="copy">
    <h2>{heading}</h2>
    <p>{body}</p>
    {action && <p class="action">{action}</p>}
  </div>
</section>

<style>
  section {
    display: grid;
    gap: var(--space-gutter);
    padding: var(--space-section) var(--space-gutter);
  }

  .copy {
    display: grid;
    gap: var(--space-stack);
    align-content: center;
    justify-items: start;
  }

  h2 {
    font-size: var(--heading-lg);
    max-width: 22ch;
  }

  p {
    max-width: 52ch;
    color: var(--text-muted);
  }

  .action {
    margin: 0;
    padding: var(--space-inset) var(--space-gutter);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius-control);
  }

  .media :global([data-component='media-placeholder']) {
    min-height: calc(var(--space-section) * 4);
  }

  @media (width >= var(--breakpoint-md)) {
    .with-media {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .right .copy {
      order: -1;
    }
  }
</style>
