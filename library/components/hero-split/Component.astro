---
interface Props {
  heading: string;
  lede?: string;
  mediaSide?: 'left' | 'right';
  variant?: 'compact' | 'full-bleed';
  action?: string;
  note?: string;
}

const {
  heading,
  lede,
  mediaSide = 'right',
  variant = 'full-bleed',
  action,
  note,
} = Astro.props;
---

<section data-component="hero-split" data-note={note} class:list={['hero', variant, mediaSide]}>
  <div class="copy">
    <h1>{heading}</h1>
    {lede && <p>{lede}</p>}
    {action && <p class="action">{action}</p>}
  </div>
  <div class="media">
    <slot name="media" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-gutter);
    padding: var(--space-section) var(--space-gutter);
  }

  .hero.full-bleed {
    background: var(--surface-raised);
  }

  .hero.compact {
    padding-block: var(--space-gutter);
  }

  .copy {
    display: grid;
    align-content: center;
    gap: var(--space-stack);
  }

  h1 {
    font-size: var(--heading-xl);
    max-width: 16ch;
  }

  .compact h1 {
    font-size: var(--heading-lg);
  }

  p {
    max-width: 42ch;
    color: var(--text-muted);
  }

  .action {
    justify-self: start;
    padding: var(--space-inset) var(--space-gutter);
    background: var(--accent);
    color: var(--on-accent);
    border-radius: var(--radius-control);
  }

  @media (width >= var(--breakpoint-md)) {
    .hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .left .media {
      order: -1;
    }
  }
</style>
