---
interface Props {
  brand: string;
  labels: string[];
  hrefs: string[];
  action?: string;
  note?: string;
}

const { brand, labels, hrefs, action, note } = Astro.props;

if (labels.length !== hrefs.length) {
  throw new Error(`site-header expected ${labels.length} hrefs and received ${hrefs.length}.`);
}
---

<header data-component="site-header" data-note={note}>
  <div class="bar">
    <p class="brand">{brand}</p>
    <nav>
      {
        labels.map((label, index) => (
          <a href={hrefs[index]}>{label}</a>
        ))
      }
    </nav>
    {
      action && (
        <button type="button" class="action">
          {action}
        </button>
      )
    }
  </div>
</header>

<style>
  header {
    border-bottom: var(--border-width-hairline) solid var(--border);
    background: var(--surface-raised);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gutter);
    width: min(100%, var(--breakpoint-lg));
    margin-inline: auto;
    padding: var(--space-inset) var(--space-gutter);
  }

  .brand {
    font-family: var(--font-heading);
    font-size: var(--heading-md);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-gutter);
  }

  a {
    color: var(--text);
    text-decoration: none;
  }

  .action {
    margin: 0;
    padding: var(--space-inset) var(--space-gutter);
    border: 0;
    border-radius: var(--radius-control);
    background: var(--accent);
    color: var(--on-accent);
    font: inherit;
    cursor: pointer;
  }

  @media (width >= var(--breakpoint-md)) {
    .action {
      margin-left: auto;
    }
  }
</style>
