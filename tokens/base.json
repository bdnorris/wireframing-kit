{
  "primitive": {
    "color": {
      "gray-50": { "$type": "color", "$value": "#f6f6f4" },
      "gray-100": { "$type": "color", "$value": "#ececea" },
      "gray-200": { "$type": "color", "$value": "#dededb" },
      "gray-300": { "$type": "color", "$value": "#c8c8c4" },
      "gray-400": { "$type": "color", "$value": "#9c9c96" },
      "gray-500": { "$type": "color", "$value": "#6f6f69" },
      "gray-600": { "$type": "color", "$value": "#4e4e49" },
      "gray-700": { "$type": "color", "$value": "#333330" },
      "gray-800": { "$type": "color", "$value": "#1f1f1d" },
      "gray-900": { "$type": "color", "$value": "#121211" },
      "accent": { "$type": "color", "$value": "#3d4f63" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" },
      "24": { "$type": "dimension", "$value": "6rem" }
    },
    "font": {
      "family": {
        "heading": {
          "$type": "fontFamily",
          "$value": "Georgia, \"Iowan Old Style\", Palatino, serif"
        },
        "body": {
          "$type": "fontFamily",
          "$value": "system-ui, sans-serif"
        }
      },
      "size": {
        "caption": { "$type": "dimension", "$value": "0.75rem" },
        "body": { "$type": "dimension", "$value": "1rem" },
        "md": { "$type": "dimension", "$value": "1.5rem" },
        "lg": { "$type": "dimension", "$value": "2.25rem" },
        "xl": { "$type": "dimension", "$value": "3.25rem" }
      }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "0.25rem" },
      "md": { "$type": "dimension", "$value": "0.75rem" }
    },
    "border": {
      "hairline": { "$type": "dimension", "$value": "1px" },
      "focus": { "$type": "dimension", "$value": "2px" }
    },
    "breakpoint": {
      "sm": { "$type": "dimension", "$value": "40rem" },
      "md": { "$type": "dimension", "$value": "64rem" },
      "lg": { "$type": "dimension", "$value": "80rem" }
    }
  },
  "semantic": {
    "surface": { "$type": "color", "$value": "{primitive.color.gray-50}" },
    "surface-raised": { "$type": "color", "$value": "{primitive.color.gray-100}" },
    "surface-highlight": { "$type": "color", "$value": "{primitive.color.gray-200}" },
    "text": { "$type": "color", "$value": "{primitive.color.gray-900}" },
    "text-muted": { "$type": "color", "$value": "{primitive.color.gray-600}" },
    "border": { "$type": "color", "$value": "{primitive.color.gray-300}" },
    "accent": { "$type": "color", "$value": "{primitive.color.accent}" },
    "on-accent": { "$type": "color", "$value": "{primitive.color.gray-50}" },
    "placeholder": { "$type": "color", "$value": "{primitive.color.gray-200}" },
    "space-inset": { "$type": "dimension", "$value": "{primitive.space.4}" },
    "space-gutter": { "$type": "dimension", "$value": "{primitive.space.6}" },
    "space-stack": { "$type": "dimension", "$value": "{primitive.space.4}" },
    "space-section": { "$type": "dimension", "$value": "{primitive.space.16}" },
    "font-heading": { "$type": "fontFamily", "$value": "{primitive.font.family.heading}" },
    "font-body": { "$type": "fontFamily", "$value": "{primitive.font.family.body}" },
    "heading-xl": { "$type": "dimension", "$value": "{primitive.font.size.xl}" },
    "heading-lg": { "$type": "dimension", "$value": "{primitive.font.size.lg}" },
    "heading-md": { "$type": "dimension", "$value": "{primitive.font.size.md}" },
    "body": { "$type": "dimension", "$value": "{primitive.font.size.body}" },
    "caption": { "$type": "dimension", "$value": "{primitive.font.size.caption}" },
    "radius-card": { "$type": "dimension", "$value": "{primitive.radius.md}" },
    "radius-control": { "$type": "dimension", "$value": "{primitive.radius.sm}" },
    "border-width-hairline": { "$type": "dimension", "$value": "{primitive.border.hairline}" },
    "border-width-focus": { "$type": "dimension", "$value": "{primitive.border.focus}" },
    "breakpoint-sm": { "$type": "dimension", "$value": "{primitive.breakpoint.sm}" },
    "breakpoint-md": { "$type": "dimension", "$value": "{primitive.breakpoint.md}" },
    "breakpoint-lg": { "$type": "dimension", "$value": "{primitive.breakpoint.lg}" }
  }
}
