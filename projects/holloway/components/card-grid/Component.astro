---
interface Props {
  columns?: '2' | '3' | '4';
  note?: string;
}

const { columns = '3', note } = Astro.props;
---

<section data-component="card-grid" data-note={note}>
  <div class:list={['grid', `columns-${columns}`]}>
    <slot />
  </div>
</section>

<style>
  section {
    padding: var(--space-section) var(--space-gutter);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-gutter);
  }

  @media (width >= var(--breakpoint-md)) {
    .columns-2 {
      grid-template-columns: 1fr 1fr;
    }

    .columns-3 {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .columns-4 {
      grid-template-columns: 1fr 1fr 1fr 1fr;
    }
  }
</style>
