---
interface Props {
  title: string;
  detail?: string;
  href?: string;
  note?: string;
}

const { title, detail, href, note } = Astro.props;
const hasMedia = Astro.slots.has('media');
const Tag = href ? 'a' : 'article';
---

<Tag data-component="product-thumbnail" data-note={note} href={href}>
  {
    hasMedia && (
      <div class="media">
        <slot name="media" />
      </div>
    )
  }
  <div class="copy">
    <h3>{title}</h3>
    {detail && <p>{detail}</p>}
  </div>
</Tag>

<style>
  article,
  a {
    display: grid;
    align-content: start;
    background: var(--surface-raised);
    border: var(--border-width-hairline) solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .copy {
    display: grid;
    gap: var(--space-stack);
    padding: var(--space-inset);
  }

  h3 {
    font-family: var(--font-heading);
    font-size: var(--body);
  }

  p {
    color: var(--text-muted);
    font-size: var(--caption);
  }

  .media :global([data-component='media-placeholder']) {
    border-radius: 0;
  }
</style>
