---
import Layout from '@layouts/default';
import ContentSection from '@c/content-section';
import CardGrid from '@c/card-grid';
import Card from '@c/card';
import MediaPlaceholder from '@c/media-placeholder';
---

<Layout project="holloway" title="Soft edge">
  <ContentSection
    heading="Soft edge"
    body="Rounded repeats and open spacing for a lighter hand across fabric and paper."
  />
  <CardGrid columns="4">
    <Card title="Offset vine" body="A climbing line with leaves set off the stem.">
      <MediaPlaceholder slot="media" kind="image" label="Offset vine" />
    </Card>
    <Card title="Open petal" body="Radial petals with space left between each lobe.">
      <MediaPlaceholder slot="media" kind="image" label="Open petal" />
    </Card>
    <Card title="Drift loop" body="Loose loops that never quite close.">
      <MediaPlaceholder slot="media" kind="image" label="Drift loop" />
    </Card>
    <Card title="Soft grid" body="A faint square lattice with rounded crossings.">
      <MediaPlaceholder slot="media" kind="image" label="Soft grid" />
    </Card>
  </CardGrid>
</Layout>
