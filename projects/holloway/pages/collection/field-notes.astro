---
import Layout from '@layouts/default';
import ContentSection from '@c/content-section';
import CardGrid from '@c/card-grid';
import Card from '@c/card';
import MediaPlaceholder from '@c/media-placeholder';
---

<Layout project="holloway" title="Field notes">
  <ContentSection
    heading="Field notes"
    body="Quiet marks and lines drawn from notebooks and site sketches, kept together for a closer look."
  />
  <CardGrid columns="4">
    <Card title="Stripe field" body="Parallel lines at even spacing across a panel.">
      <MediaPlaceholder slot="media" kind="image" label="Stripe field" />
    </Card>
    <Card title="Dot lattice" body="A light grid of dots without a hard edge.">
      <MediaPlaceholder slot="media" kind="image" label="Dot lattice" />
    </Card>
    <Card title="Pencil hatch" body="Short crossed strokes that read as tone.">
      <MediaPlaceholder slot="media" kind="image" label="Pencil hatch" />
    </Card>
    <Card title="Margin rule" body="A single thin line set in from the edge.">
      <MediaPlaceholder slot="media" kind="image" label="Margin rule" />
    </Card>
  </CardGrid>
</Layout>
