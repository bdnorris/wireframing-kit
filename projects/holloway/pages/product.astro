---
import Layout from '@layouts/default';
import ProductDetail from '@c/product-detail';
import MediaPlaceholder from '@c/media-placeholder';
---

<Layout project="holloway" title="Product">
  <ProductDetail
    title="Oak study"
    details={['Turned oak', 'Small scale', 'From Collection 1']}
    frames={['Front', 'Side', 'Detail', 'Back']}
    current="Front"
    action="Add to Cart"
  >
