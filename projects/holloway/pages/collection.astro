---
import Layout from '@layouts/default';
import ContentSection from '@c/content-section';
import CardGrid from '@c/card-grid';
import Card from '@c/card';
import ProductList from '@c/product-list';
import ProductThumbnail from '@c/product-thumbnail';
import MediaPlaceholder from '@c/media-placeholder';

const prefix = process.env.PROJECT ? '' : '/holloway';
---

<Layout project="holloway" title="Collections">
  <ContentSection
    heading="Collections"
    body="Each collection gathers a small set of patterns so they can be compared side by side."
  />
  <CardGrid columns="2">
    <Card
      title="Field notes"
      body="Quiet marks and lines drawn from notebooks and site sketches."
      href={`${prefix}/collection/field-notes`}
    >
      <MediaPlaceholder slot="media" kind="image" label="Field notes" />
    </Card>
    <Card
      title="Studio table"
      body="Patterns that sit well on a flat surface under good light."
      href={`${prefix}/collection/studio-table`}
    >
      <MediaPlaceholder slot="media" kind="image" label="Studio table" />
    </Card>
    <Card
      title="Soft edge"
      body="Rounded repeats and open spacing for a lighter hand."
      href={`${prefix}/collection/soft-edge`}
    >
      <MediaPlaceholder slot="media" kind="image" label="Soft edge" />
    </Card>
    <Card
      title="Open shelf"
      body="Stronger blocks and weaves meant to read from across a room."
      href={`${prefix}/collection/open-shelf`}
    >
      <MediaPlaceholder slot="media" kind="image" label="Open shelf" />
    </Card>
  </CardGrid>
  <ProductList heading="Featured Products" columns="4">
    <ProductThumbnail title="Pale cup" detail="Porcelain, thin" href={`${prefix}/product`}>
      <MediaPlaceholder slot="media" kind="image" label="Pale cup" />
    </ProductThumbnail>
    <ProductThumbnail title="Bound book" detail="Cloth and thread" href={`${prefix}/product`}>
      <MediaPlaceholder slot="media" kind="image" label="Bound book" />
    </ProductThumbnail>
    <ProductThumbnail title="Oak study" detail="Turned oak, small" href={`${prefix}/product`}>
      <MediaPlaceholder slot="media" kind="image" label="Oak study" />
    </ProductThumbnail>
    <ProductThumbnail title="Line vessel" detail="Stoneware, ash glaze" href={`${prefix}/product`}>
      <MediaPlaceholder slot="media" kind="image" label="Line vessel" />
    </ProductThumbnail>
  </ProductList>
</Layout>
