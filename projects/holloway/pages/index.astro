---
import Layout from '@layouts/default';
import HeroSplit from '@c/hero-split';
import MediaPlaceholder from '@c/media-placeholder';
import CardGrid from '@c/card-grid';
import Card from '@c/card';
import ContentSection from '@c/content-section';
import ProductList from '@c/product-list';
import ProductThumbnail from '@c/product-thumbnail';

const prefix = process.env.PROJECT ? '' : '/holloway';
---

<Layout project="holloway" title="Project Holloway">
  <HeroSplit
    heading="Holloway Prints"
    lede="A first look at the work, with room to add the rest."
    mediaSide="right"
    action="Browse the collection"
  >
    <MediaPlaceholder slot="media" kind="image" label="Featured piece" />
  </HeroSplit>
  <ContentSection
    heading="Pattern Collection"
    body="A selection of patterns from the collection."
    action="Browse all patterns"
    href={`${prefix}/patterns`}
  />
  <CardGrid>
    <Card title="Field notes" body="Quiet marks and lines drawn from notebooks and site sketches." href={`${prefix}/collection/field-notes`}>
      <MediaPlaceholder slot="media" kind="image" label="Field notes" />
    </Card>
    <Card title="Studio table" body="Patterns that sit well on a flat surface under good light." href={`${prefix}/collection/studio-table`}>
      <MediaPlaceholder slot="media" kind="image" label="Studio table" />
    </Card>
    <Card title="Soft edge" body="Rounded repeats and open spacing for a lighter hand." href={`${prefix}/collection/soft-edge`}>
      <MediaPlaceholder slot="media" kind="image" label="Soft edge" />
    </Card>
  </CardGrid>
  <ContentSection
    heading="Made to be looked at closely"
    body="Each piece is finished by hand, then set beside the others so you can compare scale, material, and finish before you choose."
    action="Browse the collection"
    mediaSide="left"
  >
    <MediaPlaceholder slot="media" kind="image" label="Studio table" />
  </ContentSection>
  <ContentSection
    heading="Ask about a piece"
    body="If something in the set catches your eye, write and we will send sizes, materials, and what is still available."
    action="Get in touch"
    mediaSide="right"
  >
    <MediaPlaceholder slot="media" kind="image" label="Written note" />
  </ContentSection>
</Layout>
