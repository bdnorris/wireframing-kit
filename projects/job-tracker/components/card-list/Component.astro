---
interface Props {
  layout?: 'list' | 'grid';
  sortBy?: 'date' | 'name';
  note?: string;
}

const { layout = 'list', sortBy = 'date', note } = Astro.props;
---

<div data-component="card-list" data-note={note} data-card-list data-layout={layout} data-sort={sortBy}>
  <div class="toolbar">
    <div class="control">
      <span class="label">Sort</span>
      <div class="toggle" role="group" aria-label="Sort cards">
        <button
          type="button"
          data-sort-option="date"
          aria-pressed={sortBy === 'date' ? 'true' : 'false'}
        >
          Date
        </button>
        <button
          type="button"
          data-sort-option="name"
          aria-pressed={sortBy === 'name' ? 'true' : 'false'}
        >
          Name
        </button>
      </div>
    </div>
    <div class="control">
      <span class="label">View</span>
      <div class="toggle" role="group" aria-label="View layout">
        <button
          type="button"
          data-layout-option="list"
          aria-pressed={layout === 'list' ? 'true' : 'false'}
        >
          List
        </button>
        <button
          type="button"
          data-layout-option="grid"
          aria-pressed={layout === 'grid' ? 'true' : 'false'}
        >
          Grid
        </button>
      </div>
    </div>
  </div>
  <div class:list={['items', layout]} data-card-list-items>
    <slot />
  </div>
</div>

<script>
  function parseUpdated(card) {
    const text = card.querySelector('.updated')?.textContent ?? '';
    const cleaned = text.replace(/^updated\s+/i, '').trim();
    const parsed = Date.parse(`${cleaned} 2026`);
    return Number.isNaN(parsed) ? 0 : parsed;
  }

  function parseTitle(card) {
    return (card.querySelector('h3')?.textContent ?? '').trim().toLowerCase();
  }

  function wireCardList(root) {
    const items = root.querySelector('[data-card-list-items]');
    const layoutButtons = [...root.querySelectorAll('[data-layout-option]')];
    const sortButtons = [...root.querySelectorAll('[data-sort-option]')];
    if (!items) return;

    function setLayout(next) {
      root.dataset.layout = next;
      items.classList.toggle('list', next === 'list');
      items.classList.toggle('grid', next === 'grid');
      layoutButtons.forEach((button) => {
        const active = button.dataset.layoutOption === next;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    function setSort(next) {
      root.dataset.sort = next;
      const cards = [...items.children];
      cards.sort((a, b) => {
        if (next === 'name') {
          return parseTitle(a).localeCompare(parseTitle(b));
        }
        return parseUpdated(b) - parseUpdated(a);
      });
      cards.forEach((card) => items.appendChild(card));
      sortButtons.forEach((button) => {
        const active = button.dataset.sortOption === next;
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    root.addEventListener('click', (event) => {
      const layoutButton = event.target.closest('[data-layout-option]');
      if (layoutButton && root.contains(layoutButton)) {
        const next = layoutButton.dataset.layoutOption;
        if (next === 'list' || next === 'grid') setLayout(next);
        return;
      }
      const sortButton = event.target.closest('[data-sort-option]');
      if (sortButton && root.contains(sortButton)) {
        const next = sortButton.dataset.sortOption;
        if (next === 'date' || next === 'name') setSort(next);
      }
    });
  }

  document.querySelectorAll('[data-card-list]').forEach(wireCardList);
</script>

<style>
  [data-card-list] {
    display: grid;
    gap: var(--space-stack);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-gutter);
  }

  .control {
    display: inline-flex;
    align-items: center;
    gap: var(--space-stack);
  }

  .label {
    color: var(--text-muted);
    font-size: var(--caption);
  }

  .toggle {
    display: inline-flex;
    border: var(--border-width-hairline) solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface-raised);
  }

  button {
    margin: 0;
    padding: var(--space-stack) var(--space-inset);
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--caption);
    cursor: pointer;
  }

  button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--on-accent);
  }

  .items {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-stack);
  }

  @media (width >= var(--breakpoint-md)) {
    .items.grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: var(--space-gutter);
    }
  }
</style>
